<Window x:Class="ControleEnvios.Views.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Sistema" Height="650" Width="640"
        WindowStartupLocation="CenterOwner"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Background="#0f172a">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Configurações &amp; Gestão de Dados" FontSize="20" FontWeight="Bold" Foreground="#f8fafc"/>
            <TextBlock Text="Importação/Exportação Excel, leitura de e-mails de coleta dos Correios e credenciais." FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulário Scrollável -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- 1. Seção: Importação e Exportação Excel (Conforme solicitado) -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📊 GESTÃO DE PLANILHAS EXCEL (.XLSX)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <TextBlock Text="Importe ou exporte relatórios de envios com clientes, produtos, origem, notas fiscais e custos." FontSize="12" Foreground="#cbd5e1" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="📥 Importar Planilha Excel" Background="#0284c7" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Bold" Click="BtnImportarExcel_Click" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="📊 Exportar Planilha Excel" Background="#047857" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Bold" Click="BtnExportarExcel_Click" Cursor="Hand"/>
                        </Grid>

                        <TextBlock x:Name="TxtStatusExcel" Text="" Foreground="#38bdf8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. Seção: Coleta Correios & E-mail (Custo Real e Rastreio pós-coleta) -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📬 ATUALIZAÇÃO PÓS-COLETA (HTML &amp; LEITURA DE E-MAIL)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <TextBlock Text="Após a coleta dos Correios, importe o comprovante HTML recebido ou configure a leitura de e-mail para preencher o Custo Real e Rastreio." FontSize="12" Foreground="#cbd5e1" Margin="0,0,0,12"/>

                        <!-- Botão Importar HTML direto -->
                        <Border Background="#0f172a" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Comprovante de Coleta em HTML" FontWeight="SemiBold" Foreground="#f8fafc" FontSize="12"/>
                                    <TextBlock Text="Carregue o arquivo .html salvo do e-mail da coleta" Foreground="#94a3b8" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📄 Carregar HTML de Coleta" Background="#2563eb" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="Bold" Click="BtnCarregarHtmlColeta_Click" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Caixa explicativa sobre Gmail e Senha de Aplicativo -->
                        <Border Background="#0f172a" CornerRadius="6" Padding="12" BorderBrush="#0284c7" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 Como conectar com sua conta Gmail / Google Workspace:" FontWeight="Bold" Foreground="#38bdf8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="1. Acesse: https://myaccount.google.com/security" Foreground="#cbd5e1" FontSize="11"/>
                                <TextBlock Text="2. Ative a 'Verificação em duas etapas' caso ainda não esteja ativada." Foreground="#cbd5e1" FontSize="11"/>
                                <TextBlock Text="3. Acesse 'Senhas de app' (ou pesquise 'Senhas de app' na barra de busca da Conta Google)." Foreground="#cbd5e1" FontSize="11"/>
                                <TextBlock Text="4. Crie uma senha chamada 'Controle Envios' e cole os 16 caracteres gerados no campo de Senha abaixo." Foreground="#cbd5e1" FontSize="11"/>
                                <TextBlock Text="• Remetente monitorado padrão: naorespondacorreios@gmail.com" Foreground="#94a3b8" FontSize="11" Margin="0,4,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- Configurações Servidor de E-mail IMAP -->
                        <TextBlock Text="Dados do Servidor IMAP (Gmail):" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Servidor IMAP (ex: imap.gmail.com):" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmailHost" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta SSL:" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmailPorta" Text="993" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="E-mail Gmail da Empresa:" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmailUsuario" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Senha de Aplicativo (16 caracteres):" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtEmailSenha" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Remetente dos Correios a filtrar:" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEmailRemetenteFiltro" Text="naorespondacorreios@gmail.com" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                        </StackPanel>

                        <Button x:Name="BtnTestarEmail" Content="🔍 Testar Conexão &amp; Ler E-mails Agora" Background="#334155" Foreground="#38bdf8" BorderThickness="1" BorderBrush="#475569" Padding="12,8" FontWeight="SemiBold" Click="BtnTestarEmail_Click" Cursor="Hand"/>
                        <TextBlock x:Name="TxtStatusEmail" Foreground="#38bdf8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Seção: Credenciais Correios API -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🏢 API DOS CORREIOS (RASTREAMENTO)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <TextBlock Text="Informe apenas a Chave de Acesso da API (ou Usuário + Chave) para consultar o status das encomendas." FontSize="12" Foreground="#cbd5e1" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Usuário / CNPJ (IdCorreios):" Foreground="#cbd5e1" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="TxtUsuario" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="7" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chave de Acesso da API:" Foreground="#cbd5e1" Margin="0,0,0,4" FontSize="11"/>
                                <PasswordBox x:Name="TxtCodigoAcesso" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="7" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BtnTestarConexao" Content="Testar Chave de API dos Correios" Background="#0369a1" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Click="BtnTestarConexao_Click" Cursor="Hand"/>
                        <TextBlock x:Name="TxtStatusTeste" Foreground="#38bdf8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. Seção: Integração de Nota Fiscal (Preparação Futura) -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📄 INTEGRAÇÃO NOTA FISCAL (API EXTERNA)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <TextBlock Text="Preparação para associação automática de NF gerada em outro software via API." FontSize="12" Foreground="#cbd5e1" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="URL Base da API de NF (ex: https://api.meuerp.com.br):" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNfeApiUrl" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Token / Chave de Acesso API NF:" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="TxtNfeApiToken" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Seção: Arquivamento Automático -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📦 ARQUIVAMENTO DE ENVIOS ENTREGUES" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <TextBlock Text="Mantenha a tela inicial limpa arquivando automaticamente pedidos entregues após determinado período." FontSize="12" Foreground="#cbd5e1" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkArquivar7Dias" Content="Arquivar automaticamente envios após 7 dias com status 'Entregue'" IsChecked="True" Foreground="#f8fafc" FontSize="12" Margin="0,0,0,10"/>

                        <Button Content="📦 Executar Arquivamento de Entregues (> 7 dias) Agora" Background="#334155" Foreground="#f8fafc" BorderThickness="1" BorderBrush="#475569" Padding="12,7" FontWeight="SemiBold" Click="BtnExecutarArquivamentoAgora_Click" Cursor="Hand" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtStatusArquivamento" Foreground="#38bdf8" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. Seção Segundo Plano -->
                <Border Background="#1e293b" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⏱️ MONITORAMENTO EM SEGUNDO PLANO" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Intervalo de verificação automática:" Foreground="#cbd5e1" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtIntervalo" Width="60" Text="60" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" TextAlignment="Center" FontSize="13"/>
                            <TextBlock Text="minutos" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkMinimizarTray" Content="Minimizar para a Bandeja do Sistema (perto do relógio) ao fechar" IsChecked="True" Foreground="#f8fafc" FontSize="12" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkNotificar" Content="Exibir notificações na tela ao detectar mudanças (Saiu p/ entrega, etc.)" IsChecked="True" Foreground="#f8fafc" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Botões Rodapé -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Background="#334155" Foreground="#f8fafc" BorderThickness="0" Padding="18,8" FontWeight="SemiBold" Click="BtnCancelar_Click" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="Salvar Configurações" Background="#2563eb" Foreground="White" BorderThickness="0" Padding="22,8" FontWeight="Bold" Click="BtnSalvar_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
