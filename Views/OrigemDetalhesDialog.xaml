<Window x:Class="ControleEnvios.Views.OrigemDetalhesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes da Origem / Fornecedor" Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo -->
        <Border Grid.Row="0" Background="#1e293b" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtIconeTipo" Text="🏬" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTituloOrigem" Text="Origem do Envio" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitulo" Text="Informações do local de postagem / fornecedor de mercadoria" FontSize="12" Foreground="#94a3b8" Margin="28,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" x:Name="BadgeTipo" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Background="#0284c7">
                    <TextBlock x:Name="TxtTipoBadge" Text="ESTOQUE PRÓPRIO" FontWeight="Bold" FontSize="11" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Painel Central com Dados -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="8" Padding="18" BorderBrush="#334155" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Identificação -->
                    <TextBlock Text="IDENTIFICAÇÃO DO REMETENTE / FORNECEDOR" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Razão Social / Nome:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtNome" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nome Fantasia / Apelido:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtApelido" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CNPJ / CPF:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtCnpj" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefone / WhatsApp:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtTelefone" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Endereço de Coleta / Origem -->
                    <Separator Background="#334155" Margin="0,4,0,12"/>
                    <TextBlock Text="ENDEREÇO DE ORIGEM / LOCAL DE POSTAGEM" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CEP:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtCep" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Logradouro (Rua, Av.):" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtLogradouro" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Número:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtNumero" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Complemento:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtComplemento" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Bairro:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtBairro" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="UF:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtUf" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cidade:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtCidade" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="E-mail:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEmail" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PanelObs" Margin="0,0,0,10">
                        <TextBlock Text="Observações / Anotações:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtObservacoes" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6" FontSize="12" Height="45" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rodapé de Ações -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAbrirFornecedores" Content="🏬 Abrir Gerenciador de Fornecedores" Background="#334155" Foreground="#f8fafc" BorderThickness="0" Padding="12,7" FontSize="11" FontWeight="SemiBold" Click="BtnAbrirFornecedores_Click" Cursor="Hand" Margin="0,0,8,0"/>
                <Button x:Name="BtnSalvarLoja" Content="💾 Salvar Dados da Loja" Background="#059669" Foreground="White" BorderThickness="0" Padding="12,7" FontSize="11" FontWeight="Bold" Click="BtnSalvarLoja_Click" Cursor="Hand"/>
            </StackPanel>

            <Button Content="Fechar" Background="#1e293b" Foreground="#cbd5e1" BorderBrush="#334155" BorderThickness="1" Padding="18,7" FontWeight="SemiBold" HorizontalAlignment="Right" Click="BtnFechar_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
