<Window x:Class="ControleEnvios.Views.ManifestacaoResultadoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manifestação nos Correios (PI)" Height="580" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a"
        ResizeMode="NoResize">
    
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Topo / Cabeçalho -->
            <RowDefinition Height="*"/>    <!-- Conteúdo / Detalhes -->
            <RowDefinition Height="Auto"/> <!-- Ações / Rodapé -->
        </Grid.RowDefinitions>

        <!-- 1. Cabeçalho Dinâmico -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BadgeIcone" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#064e3b" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtIcone" Text="✅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitulo" Text="Reclamação Aberta nos Correios" FontSize="18" FontWeight="Bold" Foreground="#f8fafc"/>
                <TextBlock x:Name="TxtSubtitulo" Text="Status do envio do Pedido de Informação (PI)" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 2. Conteúdo Central -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <!-- Painel de Sucesso -->
                <Border x:Name="PainelSucesso" Background="#064e3b" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="PROTOCOLO OFICIAL GERADO" FontSize="11" FontWeight="Bold" Foreground="#6ee7b7" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtProtocolo" Text="PI-000000000" FontSize="22" FontWeight="Bold" Foreground="#34d399" Margin="0,0,0,8"/>
                        <TextBlock Text="✓ Este protocolo foi registrado na API dos Correios e salvo no histórico deste pedido." FontSize="12" Foreground="#a7f3d0" Margin="0,0,0,4"/>
                        <TextBlock Text="Prazo estimado de resposta oficial dos Correios: até 5 dias úteis." FontSize="11" Foreground="#6ee7b7" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Painel de Recusa / Negado -->
                <StackPanel x:Name="PainelRecusa" Visibility="Visible">
                    <!-- Box 1: Motivo Exato dos Correios -->
                    <Border Background="#450a0a" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚠️ MOTIVO EXATO INFORMADO PELOS CORREIOS:" FontSize="11" FontWeight="Bold" Foreground="#fca5a5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtMotivoRecusa" Text="O objeto se encontra dentro do prazo previsto de entrega." FontSize="13" FontWeight="SemiBold" Foreground="#fee2e2" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Box 2: Quando poderá ser realizado novamente -->
                    <Border Background="#172554" BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📅 QUANDO PODERÁ SER REALIZADO NOVAMENTE?" FontSize="11" FontWeight="Bold" Foreground="#93c5fd" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDataPermitida" Text="A partir de: 20/10/2026 (1º dia útil após o vencimento do prazo)" FontSize="13" FontWeight="Bold" Foreground="#60a5fa" Margin="0,0,0,4"/>
                            <TextBlock Text="Os Correios bloqueiam a abertura automática de manifestação enquanto a remessa estiver dentro da estimativa de entrega." FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Opções de Ação Manual e Contingência -->
                <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="OPÇÕES DISPONÍVEIS AGORA:" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>

                        <!-- Botão 1: Abrir Portal Correios -->
                        <Button x:Name="BtnAbrirPortalCorreios" Click="BtnAbrirPortalCorreios_Click" Background="#0f172a" BorderBrush="#3b82f6" BorderThickness="1" Padding="12,9" HorizontalContentAlignment="Left" Cursor="Hand" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Abrir Portal Fale Conosco dos Correios (Navegador)" FontWeight="Bold" Foreground="#60a5fa" FontSize="12"/>
                                    <TextBlock Text="Abre o formulário oficial para tentar manifestar manualmente" Foreground="#94a3b8" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Botão 2: Copiar Dados da Reclamação -->
                        <Button x:Name="BtnCopiarDados" Click="BtnCopiarDados_Click" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="12,9" HorizontalContentAlignment="Left" Cursor="Hand" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Copiar Dados Formatados da Reclamação (PI)" FontWeight="Bold" Foreground="#f8fafc" FontSize="12"/>
                                    <TextBlock Text="Copia rastreio, cliente, postagem e motivo para colar no site" Foreground="#94a3b8" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Botão 3: Avisar Cliente no WhatsApp -->
                        <Button x:Name="BtnAvisarClienteWhats" Click="BtnAvisarClienteWhats_Click" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="12,9" HorizontalContentAlignment="Left" Cursor="Hand" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Copiar Mensagem Preventiva para o Cliente (WhatsApp)" FontWeight="Bold" Foreground="#f97316" FontSize="12"/>
                                    <TextBlock Text="Mensagem humanizada explicando que o envio está sendo acompanhado" Foreground="#94a3b8" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Botão 4: Tentar Reenviar via API Agora -->
                        <Button x:Name="BtnReenviarApi" Click="BtnReenviarApi_Click" Background="#0f172a" BorderBrush="#059669" BorderThickness="1" Padding="12,9" HorizontalContentAlignment="Left" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtIconeReenviar" Text="🔄" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTituloReenviar" Text="Tentar Reenviar via API Agora" FontWeight="Bold" Foreground="#34d399" FontSize="12"/>
                                    <TextBlock Text="Força uma nova chamada à API dos Correios" Foreground="#94a3b8" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Feedback de Ação -->
                <TextBlock x:Name="TxtFeedbackAcao" Text="" Foreground="#38bdf8" FontSize="11" Margin="2,4,0,0" FontStyle="Italic"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. Rodapé com Botão Fechar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Fechar" Background="#334155" Foreground="#f8fafc" BorderThickness="0" Padding="20,8" FontWeight="SemiBold" Click="BtnFechar_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
