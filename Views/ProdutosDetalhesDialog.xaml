<Window x:Class="ControleEnvios.Views.ProdutosDetalhesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Itens do Pedido" Height="500" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a">
    
    <Window.Resources>
        <!-- Estilo Cabeçalho DataGrid -->
        <Style x:Key="ProdutosHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0b1329"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#1e293b"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Estilo Linha DataGrid -->
        <Style x:Key="ProdutosRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1e293b"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e293b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Célula -->
        <Style x:Key="ProdutosCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo: Título e Informações do Pedido -->
        <Border Grid.Row="0" Background="#1e293b" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTituloPedido" Text="Produtos do Pedido #0000" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCliente" Text="Cliente: -" FontSize="12" Foreground="#94a3b8" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Totais Consolidados -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0f172a" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL DE ITENS" FontSize="9" FontWeight="Bold" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtTotalItens" Text="0 peças" FontSize="13" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0f172a" CornerRadius="6" Padding="10,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="VALOR PRODUTOS" FontSize="9" FontWeight="Bold" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtValorTotal" Text="R$ 0,00" FontSize="13" FontWeight="Bold" Foreground="#34d399" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela de Produtos -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="GridItens" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="#1e293b" BorderThickness="0" RowBackground="#0f172a" AlternatingRowBackground="#1e293b"
                          Foreground="#f8fafc" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          ColumnHeaderStyle="{StaticResource ProdutosHeaderStyle}"
                          RowStyle="{StaticResource ProdutosRowStyle}"
                          CellStyle="{StaticResource ProdutosCellStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUTO" Binding="{Binding NomeProduto}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="CÓDIGO / REF" Binding="{Binding Codigo}" Width="110"/>
                        <DataGridTextColumn Header="TAMANHO" Binding="{Binding Tamanho}" Width="80"/>
                        <DataGridTextColumn Header="QTD" Binding="{Binding Quantidade}" Width="60"/>
                        <DataGridTextColumn Header="VALOR UNIT." Binding="{Binding ValorUnitario, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding ValorTotal, StringFormat=C}" Width="100" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mensagem se lista estiver vazia (ex: importado só por e-mail sem PDF ainda) -->
                <Border x:Name="PanelSemItens" Background="#1e293b" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ℹ️ Nenhum item individual cadastrado para este envio." Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtResumoGenerico" Text="Resumo: -" Foreground="#cbd5e1" FontSize="12" Margin="0,6,0,12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dica: Arraste o arquivo PDF da Tray no botão 'Novo Envio' ou edite o envio para carregar os produtos detalhados." Foreground="#64748b" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Visualização detalhada dos itens do pedido da loja" Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="Fechar" Background="#334155" Foreground="#f8fafc" BorderThickness="0" Padding="18,7" FontWeight="SemiBold" HorizontalAlignment="Right" Click="BtnFechar_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
